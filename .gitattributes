# Normalize line endings to LF in the repo, checked out native on each OS.
* text=auto eol=lf

# Explicit text types.
*.ts    text
*.tsx   text
*.js    text
*.mjs   text
*.json  text
*.md    text
*.css   text
*.yml   text
*.yaml  text
*.prisma text

# Generated / vendored — collapse in diffs and exclude from language stats.
package-lock.json linguist-generated=true -diff

# Binary assets — never touch line endings.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.pdf   binary
*.ico   binary
*.woff  binary
*.woff2 binary
